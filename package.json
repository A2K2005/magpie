{
  "name": "magpie",
  "version": "0.2.0",
  "description": "Search every screenshot by the words in it or what it shows. Fully offline.",
  "author": "Magpie",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --cache .",
    "format": "prettier --write src",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "icons": "tauri icon build/icon.svg",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.6"
  },
  "private": true
}
