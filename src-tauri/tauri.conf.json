{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Magpie",
  "version": "0.2.0",
  "identifier": "app.magpie.desktop",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Search every screenshot, offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
